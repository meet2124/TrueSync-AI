# ============================================================
# TrueSync AI — Environment Configuration
# Copy this file to .env and fill in real values.
# Never commit .env to version control.
# ============================================================

# --- Server ---
BACKEND_HOST=0.0.0.0                   # Host the FastAPI server binds to
BACKEND_PORT=8000                       # Port the FastAPI server listens on

# --- WebSocket ---
WEBSOCKET_URL=ws://localhost:8000/ws/session   # URL the frontend connects to

# --- Engine ---
# "mock"       → uses MockEngine (Phase 1, always safe)
# "production" → uses the real ML engine (Phase 2, requires real models)
ENGINE_MODE=mock

# --- Mock Engine Tuning ---
MOCK_TRUST_MIN=0.82    # Lower bound of overall_trust (0.0–1.0 scale internally)
MOCK_TRUST_MAX=0.96    # Upper bound of overall_trust (0.0–1.0 scale internally)
TARGET_FPS=30          # Target frames-per-second for the engine loop

# --- Phase 2 (leave blank in Phase 1) ---
ML_API_KEY=            # API key for remote model-hosting service (future use)
