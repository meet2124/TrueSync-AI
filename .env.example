# ============================================================
# TrueSync AI — Environment Configuration
# Copy this file to .env and fill in real values.
# Never commit .env to version control.
# ============================================================

# --- Server ---
# Bind to 0.0.0.0 for EC2/cloud deployment (not localhost)
BACKEND_HOST=0.0.0.0
BACKEND_PORT=8000

# --- WebSocket ---
# Local development:
WEBSOCKET_URL=ws://localhost:8000/ws/session
# EC2 production (replace with your EC2 public IP or domain):
# WEBSOCKET_URL=wss://your-domain.ap-south-1.compute.amazonaws.com/ws/session

# --- Engine ---
# "mock"       → uses MockEngine (Phase 1, always safe for demo)
# "production" → uses the real ML engine (Phase 2, requires real models)
ENGINE_MODE=mock

# --- Mock Engine Tuning ---
MOCK_TRUST_MIN=0.82    # Lower bound of overall_trust (0.0–1.0 scale internally)
MOCK_TRUST_MAX=0.96    # Upper bound of overall_trust (0.0–1.0 scale internally)
TARGET_FPS=30          # Target frames-per-second for the engine loop

# --- Security ---
# Comma-separated CORS origins. Use * for development only.
# For EC2: set to your actual frontend URL(s)
# Example: CORS_ORIGINS=https://your-domain.com,https://www.your-domain.com
CORS_ORIGINS=*

# Maximum WebSocket payload size in bytes (default 5 MB)
MAX_PAYLOAD_BYTES=5242880

# Number of ThreadPoolExecutor workers for CPU-bound biometric processing
WORKER_THREADS=4

# --- Logging ---
# Options: DEBUG, INFO, WARNING, ERROR
LOG_LEVEL=INFO

# --- AWS Deployment (ap-south-1) ---
# Region where this service is deployed
AWS_REGION=ap-south-1

# Optional: CloudWatch log group name (if using CloudWatch agent)
# CLOUDWATCH_LOG_GROUP=/truesync/production

# --- Phase 2 (leave blank in Phase 1) ---
ML_API_KEY=            # API key for remote model-hosting service (future use)
